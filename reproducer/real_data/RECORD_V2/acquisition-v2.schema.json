{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qrn-record-v2-acquisition",
  "title": "QRN Recorded Lane v2 — B. 取得記録 (v35.1, PROMPT/16 §3.1)",
  "description": "実装置からの取得記録。チャネルごとに source/target/probe 符号/ε/発展時間/プログラム hash を型で持ち、データは相関粒度 3 型 (ordered_shots / timestamped_batches / aggregate_counts) の oneOf。aggregate_counts に iid 証明書は発行されない (禁止変換 30)。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance",
    "evolution_provenance",
    "preregistration_sha256",
    "device",
    "operator",
    "acquisition_randomization_seed",
    "channels",
    "results_including_failures_public"
  ],
  "properties": {
    "schema_version": { "const": "record-v2-acquisition" },
    "provenance": {
      "const": "recorded_experimental",
      "description": "synthetic データの提出は不適合 (lane 分離 — v34.6 の型)"
    },
    "evolution_provenance": {
      "enum": ["native_analog_evolution", "compiled_digital_channel_family", "emulator"],
      "description": "native_analog_evolution 以外から native hardware Hamiltonian topology を主張しない (PROMPT/16 §8)。compiled_digital_channel_family は programmed-channel calibration の scope に限定。emulator は synthetic lane へ"
    },
    "preregistration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "対応する preregistration-v2 ファイルの sha256 (三段の結束)"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "device_id"],
      "properties": {
        "vendor": { "type": "string" },
        "device_id": { "type": "string" },
        "calibration_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "装置較正スナップショットの sha256 (装置全体 — チャネル別は channel 側)"
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organization", "organizationally_external"],
      "properties": {
        "name": { "type": "string" },
        "organization": { "type": "string" },
        "organizationally_external": { "type": "boolean" }
      }
    },
    "acquisition_randomization_seed": {
      "type": "string",
      "description": "+/−/time/batch の interleaving 乱択シード (取得順の恣意性の排除)"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "source_id",
          "target_id",
          "probe_sign",
          "epsilon",
          "evolution_time",
          "evolution_family_id",
          "job_id",
          "program_hash",
          "compiler_or_pulse_version",
          "calibration_snapshot_hash",
          "used_in_calibration",
          "raw_artifact_sha256",
          "data"
        ],
        "properties": {
          "channel_id": { "type": "string" },
          "source_id": { "type": "string", "description": "probe を注入する匿名 node" },
          "target_id": { "type": "string", "description": "応答を読む匿名 node" },
          "probe_sign": { "enum": ["plus", "minus"] },
          "epsilon": { "type": "number", "exclusiveMinimum": 0 },
          "evolution_time": { "type": "number", "minimum": 0 },
          "evolution_family_id": {
            "type": "string",
            "description": "同一 evolution family の識別子 — ± probe 対と時刻族は同一 family であること (validator が照合)"
          },
          "job_id": { "type": "string" },
          "program_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "実行プログラム (pulse schedule / compiled circuit) の sha256 — ± probe 間で evolution program が同一かの検査に使う"
          },
          "compiler_or_pulse_version": { "type": "string" },
          "calibration_snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "used_in_calibration": {
            "type": "boolean",
            "description": "必須 boolean — held-out チャネルは false であること (prereg と照合)"
          },
          "raw_artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "不変 raw データ成果物 (vendor 出力そのまま) の sha256"
          },
          "data": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "acquired_at", "shots"],
                "properties": {
                  "kind": { "const": "ordered_shots" },
                  "acquired_at": { "type": "string" },
                  "shots": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "integer", "minimum": 0, "maximum": 1 },
                    "description": "取得順を保存した 0/1 列 — 遷移数ゲートまで実行可能"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "batches"],
                "properties": {
                  "kind": { "const": "timestamped_batches" },
                  "batches": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["batch_id", "started_at", "ended_at", "n_shots", "n_ones"],
                      "properties": {
                        "batch_id": { "type": "string" },
                        "started_at": { "type": "string" },
                        "ended_at": { "type": "string" },
                        "n_shots": { "type": "integer", "minimum": 1 },
                        "n_ones": { "type": "integer", "minimum": 0 }
                      }
                    },
                    "description": "batch 間 drift・overdispersion のみ検査可能 (iid 資格に到達しない — 禁止変換 31)"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "acquired_at", "n_shots", "n_ones"],
                "properties": {
                  "kind": { "const": "aggregate_counts" },
                  "acquired_at": { "type": "string" },
                  "n_shots": { "type": "integer", "minimum": 1 },
                  "n_ones": { "type": "integer", "minimum": 0 }
                },
                "description": "相関検査不能 — CorrelationUnassessed のみ (iid 証明書の発行禁止 — 禁止変換 30)"
              }
            ]
          }
        }
      }
    },
    "results_including_failures_public": { "const": true }
  }
}
